---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" class={className} aria-hidden="true">
  <defs>
    <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#9478FF"></stop>
      <stop offset="1" stop-color="#5534F0"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="8" fill="url(#logo-g)"></rect>
  <circle cx="14.2" cy="14.2" r="6.6" fill="none" stroke="#fff" stroke-width="2.4"></circle>
  <path d="M19.2 19.2l5.3 5.3" stroke="#fff" stroke-width="2.6" stroke-linecap="round"></path>
  <rect x="11.8" y="11.8" width="4.8" height="4.8" rx="0.8" fill="#fff"></rect>
</svg>
