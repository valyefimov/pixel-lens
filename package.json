{
  "name": "pixel-lens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:ext": "pnpm --filter @pixel-lens/extension dev",
    "dev:web": "pnpm --filter @pixel-lens/landing dev",
